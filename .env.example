# Server
SERVER_LISTEN=0.0.0.0:5680
SERVER_PUBLIC_BASE_URL=http://localhost:5680
SERVER_ADMIN_BOOTSTRAP_KEY=change-me-in-production
SERVER_JWT_SECRET=change-me-use-random-64-chars
SERVER_CORS_ALLOWED_ORIGINS=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5679/tokimo_server

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_LOCAL_PUBLIC_BASE=http://localhost:5680/assets

# S3 (when STORAGE_BACKEND=s3)
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_ENDPOINT=                 # optional — leave unset for AWS S3, set for MinIO / S3-compatible
# STORAGE_S3_PUBLIC_BASE=              # required when PRESIGN_TTL_SECONDS=0 (public bucket)
# STORAGE_S3_PRESIGN_TTL_SECONDS=0     # 0 = public, >0 = private (returns presigned GET URLs)

# OSS (when STORAGE_BACKEND=oss) — Aliyun OSS speaks S3-compatible protocol
# STORAGE_OSS_BUCKET=
# STORAGE_OSS_REGION=cn-hangzhou
# STORAGE_OSS_ACCESS_KEY_ID=
# STORAGE_OSS_SECRET_ACCESS_KEY=       # also accepts STORAGE_OSS_ACCESS_KEY_SECRET
# STORAGE_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STORAGE_OSS_PUBLIC_BASE=             # required when PRESIGN_TTL_SECONDS=0
# STORAGE_OSS_PRESIGN_TTL_SECONDS=0    # 0 = public, >0 = private (returns presigned GET URLs)

# Providers
TMDB_API_KEY=

# Logging
RUST_LOG=info,tokimo_server=debug,sqlx=warn
